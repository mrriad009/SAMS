# Production environment — copy to server/.env on the VPS
# NEVER commit the real .env file to git

PORT=3003
NODE_ENV=production

# NeonDB (use production branch connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Public URLs (HTTPS)
CLIENT_URL=https://captainbnb.online
SERVER_URL=https://captainbnb.online

# Lock down open registration in production (set to true only if self-service signup is intended)
ALLOW_ADMIN_REGISTER=false
ALLOW_STUDENT_REGISTER=false

# Optional — Cloudinary for profile photos
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — Resend for password reset emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=Attendance <noreply@captainbnb.online>
